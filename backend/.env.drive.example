# Ejemplo sin secretos. Copiar solo estas dos variables al .env real del backend.
# El archivo JSON se crea con: python -m app.reportes.setup_google_drive --client .secrets/google-drive-client.json
GOOGLE_DRIVE_TOKEN_FILE=.secrets/google-drive-token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=ID_DE_LA_CARPETA_CREADA_POR_LA_APLICACION
